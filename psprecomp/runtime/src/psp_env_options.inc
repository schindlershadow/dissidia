// psp_env_options.inc: the Debug > Developer options pages (included by psp_settings.cpp).
//
// One row per PSPRECOMP_* environment variable the runtime reads, with a description. The choice is saved to settings.ini as
// "env.<NAME>" and exported to the environment at the next start (psp_settings_load_early), so it takes effect the next time the game
// starts. A row whose variable was already set in the environment when the game started shows that value until it is changed.
//
// Types:
//   'e'  enable flag: the variable switches something ON when set (unset = off).      Row: Off / On      (On sets it to 1)
//   'k'  kill switch: the feature is on unless the variable is 0 (unset = on).        Row: On / Off      (Off sets it to 0)
//   'c'  choices: "a|b|c" are the presets; the first row value "Default" leaves it unset (the game's own default).
//
// Not listed on purpose: variables the menu already has a row for (frame rate, render scale, anti-aliasing, HDR, ...), things that need
// free text or an address (file and folder paths, hex addresses, credentials, network servers), and build-time or launcher-only values.
// Add a variable here and it gets a row; keep the description to what it does and what its default is.

enum EnvCat { EC_CAMERA, EC_INPUT, EC_TIMING, EC_GRAPHICS, EC_EFFECTS, EC_VULKAN, EC_TEXTURES, EC_AV, EC_DATA, EC_LOG_GAME, EC_LOG_ENGINE, EC_COUNT };
const char* const k_env_cat_names[EC_COUNT] = {"Camera", "Input", "Timing", "Graphics", "Effects tuning", "Vulkan", "Textures", "Audio / video",
                                               "Game data", "Game logs", "Engine logs"};
const char* const k_env_cat_help[EC_COUNT] = {
    "Free camera and framing options.",
    "Stick, pad and keyboard behaviour.",
    "Frame pacing and rate-dependent game logic fixes.",
    "Renderer switches, A/B tests and presentation.",
    "Fine tuning of shadows, ambient occlusion and reflections.",
    "Vulkan layer switches and diagnostics.",
    "Texture cache, hashing and texture packs.",
    "Audio output and movie playback.",
    "Roster, model memory, save data and mods.",
    "Writes what the game's own logic is doing to the log.",
    "Writes what the engine is doing to the log.",
};

struct EnvOpt {
    const char* name;    // without the PSPRECOMP_ prefix
    int cat;
    char type;           // 'e', 'k' or 'c'
    const char* values;  // 'c': presets, "a|b|c"
    const char* desc;
};

