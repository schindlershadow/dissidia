# Generates a C++ source embedding the CA root bundle (assets/ca/cacert.pem, NUL-terminated as mbedTLS wants for PEM).
#   cmake -DPEM=<cacert.pem> -DOUT=<out.cpp> -P embed_cacert.cmake
file(READ "${PEM}" _hex HEX)
string(LENGTH "${_hex}" _hl)
math(EXPR _len "${_hl} / 2 + 1")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
file(WRITE "${OUT}" "// Generated by assets/embed_cacert.cmake - do not edit.\n"
    "extern const unsigned char psp_cacert_pem[];\nconst unsigned char psp_cacert_pem[] = {${_arr}0};\n"
    "extern const unsigned long psp_cacert_pem_len;\nconst unsigned long psp_cacert_pem_len = ${_len}UL;\n")
